{
  "$schema": "https://turborepo.com/schema.json",
  "globalEnv": ["NODE_ENV", "AI_MODE", "APP_URL"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
