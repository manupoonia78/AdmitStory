{
  "name": "admitstory",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@admitstory/web",
    "build": "turbo run build",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "turbo run typecheck",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "pnpm --filter @admitstory/web test:e2e",
    "lighthouse": "pnpm --filter @admitstory/web lighthouse",
    "db:generate": "pnpm --filter @admitstory/db generate",
    "db:migrate": "pnpm --filter @admitstory/db migrate",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:local": "pglite-server --db=.pglite --port=5433 --max-connections=10"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@electric-sql/pglite": "0.5.12",
    "@electric-sql/pglite-socket": "0.2.15",
    "@inngest/test": "1.0.0",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@vitejs/plugin-react": "6.1.2",
    "dotenv": "18.0.9",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.3",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "turbo": "2.11.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "unrs-resolver",
      "@sentry/cli",
      "sharp"
    ]
  }
}
