APP_URL=http://localhost:3000
DATABASE_URL=
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
RESEND_API_KEY=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
ANTHROPIC_API_KEY=
AI_MODE=replay            # replay | live
VOYAGE_API_KEY=
DEEPGRAM_API_KEY=
TTS_PROVIDER=deepgram     # deepgram (default, uses DEEPGRAM_API_KEY) | openai_compat | cartesia | elevenlabs
CARTESIA_API_KEY=
ELEVENLABS_API_KEY=
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
DODO_PAYMENTS_ENVIRONMENT=test_mode  # test_mode | live_mode; must match the API key
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=           # whsec_…, the webhook endpoint's signing secret
DODO_PRODUCT_SCHOOL_KIT=             # pdt_… ids from `pnpm --filter @admitstory/web payments:products`
DODO_PRODUCT_PACK5=
DODO_PRODUCT_PACK10=
CALCOM_API_KEY=
CALCOM_WEBHOOK_SECRET=
POSTHOG_KEY=
POSTHOG_HOST=
SENTRY_DSN=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=            # placeholder: Langfuse Cloud URL or your self-hosted URL (decision pending, see docs/phase-0.md)
CONTENT_ENCRYPTION_KEY_ID=
CONTENT_ENCRYPTION_KEYS=   # JSON map of key id → base64 key, from the secret store

# --- Additions beyond Section 17 (see docs/phase-0.md) ---
EMAIL_FROM=               # placeholder: sender for sign-in emails, e.g. "AdmitStory <hello@admitstories.com>"
FAKE_STT_URL=             # local fake Deepgram server used when DEEPGRAM_API_KEY is empty (default ws://localhost:8787)
PROTOTYPES_ENABLED=       # "1" serves the Phase 0.5 prototypes (/prototype) in a production build; always on in dev
SITE_URL=                 # the public marketing domain, https://admitstories.com (canonical URLs, sitemap, OG); falls back to APP_URL
DEMO_STT=on               # on | off: the kill switch for speaking in the landing hero (/api/demo/stt-token)
DEMO_DAILY_CAP=500        # most hero speaking sessions per day, across all visitors

# --- Phase 9b: hardening and launch (see docs/LAUNCH.md) ---
ADMIN_ALERT_EMAIL=        # where admin alerts are emailed (spend spikes, failed kits, untrue-draft reports)
CSP_REPORT_ONLY=          # "1" sends the Content-Security-Policy as report-only (escape hatch)
KV_REST_API_URL=          # Vercel Marketplace's name for UPSTASH_REDIS_REST_URL; either pair works
KV_REST_API_TOKEN=
OPENAI_TTS_BASE_URL=      # openai_compat TTS: a self-hosted speech server, e.g. Kokoro-FastAPI
OPENAI_TTS_API_KEY=
OPENAI_TTS_MODEL=kokoro
OPENAI_TTS_VOICES=        # JSON, e.g. {"warm":"af_heart","clear":"af_bella","low":"am_michael"}
EVAL_COST_APPROVED=       # CI only: "1" waives the eval gate's cost-rise rule for one run
